# نمونه‌ی تنظیمات محیط دلتا آپلود.
#
# این فایل را به .env کپی کن و مقادیر واقعی را بگذار. خودِ .env در .gitignore
# است و هرگز نباید کامیت شود.
#
#   cp .env.example .env
#
# متغیر محیطی سیستم بر مقدار این فایل اولویت دارد.

# ── پایه ────────────────────────────────────────────────────────────────
# روی سرور حتماً ست شود، وگرنه manage.py check خطای dup.E002 می‌دهد.
# ساختنش:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# روی سرور صفر. در توسعه اگر خالی بماند، روشن است.
DJANGO_DEBUG=1

# دامنه‌های اضافه، جدا شده با کاما. d-up.ir و localhost از قبل هستند.
DJANGO_ALLOWED_HOSTS=

# آدرس عمومی سایت. جایی لازم است که باید URL کامل ساخته شود و درخواستی در کار
# نیست: ثبت وبهوک تلگرام و دستورهای مدیریتی.
SITE_BASE_URL=https://d-up.ir

# مبدأهای مورد اعتماد CSRF از روی DJANGO_ALLOWED_HOSTS ساخته می‌شوند و معمولاً
# لازم نیست چیزی اینجا بگذاری. فقط اگر مبدأ دیگری بیرون آن فهرست داری.
CSRF_TRUSTED_ORIGINS=

# ── دیتابیس ────────────────────────────────────────────────────────────
# اجباری. پروژه فقط روی Postgres کار می‌کند؛ بدون این متغیر بالا نمی‌آید.
#
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#
# اگر رمز @ یا / دارد، percent-encode کن (@ می‌شود %40) وگرنه آدرس اشتباه
# تجزیه می‌شود.
#
# SQLite عمداً پشتیبانی نمی‌شود: یک فایل با یک نویسنده است و با چند worker
# خطای database is locked می‌دهد. توسعه هم روی همان موتوری باشد که production
# است، وگرنه کوئری‌ای که لوکال کار می‌کند روی سرور می‌شکند.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/dup

# مدت نگه‌داشتن هر اتصال، ثانیه. صفر یعنی برای هر درخواست اتصال تازه.
DB_CONN_MAX_AGE=600

# ── ایمیل ───────────────────────────────────────────────────────────────
# سرور ایمیل mail.yaspardaz.ir است، با این‌که d-up.ir را هم سرو می‌کند:
# mail.d-up.ir وجود ندارد و گواهی TLS فقط نام خود سرور را پوشش می‌دهد.
#
# EMAIL_API_KEY کلید API همان صندوق EMAIL_HOST_USER است (API_...) و بر رمز
# اولویت دارد. کلید را می‌شود جدا باطل کرد، بی آن‌که رمز صندوق عوض شود.
#
# اگر هر دو خالی باشند، ایمیل‌ها به‌جای ارسال در کنسول چاپ می‌شوند. برای توسعه
# راحت است؛ روی سرور یعنی ایمیل فعال‌سازی حساب به دست کاربر نمی‌رسد (هشدار
# dup.W003).
#
# DEFAULT_FROM_EMAIL باید همان EMAIL_HOST_USER باشد، وگرنه سرور با
# 501 5.5.4 ارسال را رد می‌کند.
#
# فرستنده noreply@ است و کسی صندوقش را نمی‌خواند؛ جواب کاربر با
# EMAIL_REPLY_TO به پشتیبانی می‌رسد.
#
# هشدار: سرور بعد از ۱۰۰ ورود ناموفق در روز، IP را برای همیشه می‌بندد. IP
# همین سرور وب است، پس کلید یا رمز را حدسی امتحان نکن.
EMAIL_HOST=mail.yaspardaz.ir
EMAIL_HOST_USER=noreply@d-up.ir
EMAIL_API_KEY=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=noreply@d-up.ir
EMAIL_REPLY_TO=support@d-up.ir

# ── کش و ریت‌لیمیت ──────────────────────────────────────────────────────
# بدون Redis، شمارنده‌ی ریت‌لیمیت درون‌پروسه‌ای می‌شود و با چند worker عملاً
# بی‌اثر است (هشدار dup.W001). db 9 عمداً جداست تا با پروژه‌های دیگر روی همان
# Redis قاطی نشود.
REDIS_URL=redis://127.0.0.1:56379/9

# ── ذخیره‌سازی فایل ─────────────────────────────────────────────────────
# USE_S3=1 یعنی فایل‌ها روی S3 بروند. باکت باید خصوصی باشد؛ دسترسی فقط با
# لینک امضاشده‌ی موقت داده می‌شود.
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ── سقف حجم آپلود ───────────────────────────────────────────────────────
# کاربر واردشده: ۲ گیگابایت. مهمان: ۲۰۰ مگابایت.
# سقف کوچک‌تر برای مهمان عمدی است — آپلود ناشناس بدون سقف یعنی دیسک سرور
# مجانی در اختیار همه.
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_GUEST_UPLOAD_SIZE_BYTES=209715200

# ── سهمیه‌ی فضا ─────────────────────────────────────────────────────────
# فضای رایگان هر کاربر (۱ گیگابایت). بیشترش با خرید بسته باز می‌شود؛ کاتالوگ
# بسته‌ها در پنل مدیریت است نه اینجا، چون قیمت‌گذاری تصمیم کسب‌وکار است و
# نباید به دیپلوی نیاز داشته باشد.
FREE_STORAGE_BYTES=1073741824

# ── کپچا ────────────────────────────────────────────────────────────────
# فقط برای reCAPTCHA گوگل لازم است. انتخاب سرویس فعال در پنل مدیریت است
# (مدیریت ← امنیت)، نه اینجا — تا وقتی گوگل از دسترس خارج شد برگرداندنش
# نیاز به دیپلوی نداشته باشد.
#
# بدون این کلیدها گزینه‌ی reCAPTCHA در پنل قابل انتخاب نیست.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── درگاه پرداخت ────────────────────────────────────────────────────────
ZARINPAL_SANDBOX=1
ZARINPAL_MERCHANT_ID=

# بدون IPN secret، هر کسی می‌تواند با یک POST ساده کیف پول خودش را شارژ کند
# (خطای dup.E001).
NOWPAYMENTS_SANDBOX=1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── ذخیره در تلگرام ────────────────────────────────────────────────────
# هیچ رباتی مال سایت نیست. هر کاربر ربات خودش را از BotFather می‌سازد و توکنش
# را در پنل خودش ثبت می‌کند، پس هیچ توکنی اینجا لازم نیست.
#
# صفر یعنی قابلیت کلا خاموش. روشن/خاموش کردن معمولی از پنل مدیریت است
# (مدیریت ← تلگرام)؛ این کلید سخت‌تر است و دیتابیس نمی‌تواند دورش بزند.
TELEGRAM_STORAGE_ENABLED=1

# توکن ربات کاربران با این کلید رمز می‌شود. خالی که باشد، کلید از SECRET_KEY
# مشتق می‌شود؛ کار می‌کند ولی یعنی عوض کردن SECRET_KEY همه‌ی توکن‌ها را
# غیرقابل خواندن می‌کند و هر کاربر باید ربات خود را دوباره ثبت کند.
# ساختنش:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_TOKEN_KEY=

# اندازه‌ی هر تکه (۱۹MB). بالای ۲۰MB نبر: getFile بیشتر از آن برنمی‌گرداند و
# فایل دیگر قابل خواندن نیست.
TELEGRAM_CHUNK_BYTES=19922944

# سقف بایت در صف انتقال برای هر کاربر (۴GB). فایل تلگرامی از سهمیه کم نمی‌شود،
# پس بدون این سقف تیک زدن آن گزینه راهی برای دور زدن سهمیه بود.
TELEGRAM_STAGING_BYTES=4294967296

# کش تکه‌های دانلودشده (۲GB). چیزی اینجا مرجع نیست و پاک کردنش همیشه بی‌خطر
# است. صفر یعنی خاموش.
TELEGRAM_CACHE_BYTES=2147483648

# ── پروکسی ──────────────────────────────────────────────────────────────
# تعداد پروکسی مورد اعتماد جلوی جنگو. صفر یعنی X-Forwarded-For نادیده گرفته
# شود. اگر پشت nginx هستی ۱ بگذار.
#
# اشتباه در این عدد یعنی هر کسی می‌تواند با جعل هدر، هم ریت‌لیمیت را دور بزند
# و هم ضدتقلب تبلیغات را.
TRUSTED_PROXY_COUNT=0
